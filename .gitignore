# ============================================================
# eth-todo-list — .gitignore
# Truffle / Node project — blocks secrets, deps, and artifacts.
# ============================================================

# --- Secrets & environment ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Dependencies — NEVER commit node_modules ---
node_modules/

# --- Databases & binary artifacts ---
*.db
*.sqlite
*.sqlite3
*.bin

# --- Python (if any Python tooling is used) ---
__pycache__/
*.py[cod]

# --- Truffle / Ganache ---
.ganache/

# --- Build logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
